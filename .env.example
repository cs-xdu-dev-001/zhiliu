APP_ENV=production
INTEGRATION_SECRET_KEY=replace-with-at-least-32-random-characters
# 仅供Hermes调用知流MCP，必须与其他密钥不同。
ZHILIU_MCP_TOKEN=replace-with-separate-32-character-random-token
# MCP回执用于生成可从微信打开的知流详情链接。
PUBLIC_BASE_URL=https://zhiliu.example.com
DEMO_MODE=false
SCHEDULER_ENABLED=true

# Hermes API Server只应监听宿主机127.0.0.1:8642。
HERMES_BASE_URL=http://127.0.0.1:8642
HERMES_API_KEY=
HERMES_TIMEOUT_SECONDS=180

# 宿主机对外提供的端口，建议再由宿主机Nginx/Caddy提供HTTPS。
WEB_PORT=8080

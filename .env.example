APP_ENV=production
JWT_SECRET=replace-with-at-least-32-random-characters
COOKIE_SECURE=true
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-unique-password
DEMO_MODE=false
SCHEDULER_ENABLED=true

# Hermes API Server只应监听宿主机127.0.0.1:8642。
HERMES_BASE_URL=http://127.0.0.1:8642
HERMES_API_KEY=replace-with-hermes-api-server-key
HERMES_TIMEOUT_SECONDS=180

# 宿主机对外提供的端口，建议再由宿主机Nginx/Caddy提供HTTPS。
WEB_PORT=8080

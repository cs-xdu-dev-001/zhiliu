mcp_servers:
  zhiliu:
    url: http://127.0.0.1:8080/api/mcp
    headers:
      Authorization: "Bearer ${ZHILIU_MCP_TOKEN}"
    tools:
      include:
        - zhiliu_begin_task
        - zhiliu_publish
        - zhiliu_report_failure
        - zhiliu_create_monitor
        - zhiliu_search
        - zhiliu_get_preferences
        - zhiliu_save_preference
        - zhiliu_remove_preference
        - zhiliu_update_item
